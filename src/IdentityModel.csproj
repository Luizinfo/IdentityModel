<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Authors>Luiz Antonio</Authors>
    <Copyright>Copyright 2017-2018 Brock Allen &amp; Dominick Baier</Copyright>
    <Description>ZinfoFramework OpenID Connect and OAuth 2.0 client library; an independent continuation maintained by Luiz Antonio, without upstream endorsement.</Description>
    <PackageId>ZinfoFramework.IdentityModel</PackageId>
    <PackageVersion>10.0.0</PackageVersion>
    <Version>10.0.0</Version>
    <PackageTags>ZinfoFramework;OAuth2;OAuth 2.0;OpenID Connect;Security;Identity</PackageTags>
    <PackageIcon>icon.jpg</PackageIcon>
    <PackageProjectUrl>https://github.com/Luizinfo/IdentityModel</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Luizinfo/IdentityModel.git</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>ZinfoFramework.IdentityModel 10.0.0 is the first ZinfoFramework release of this independent continuation. It targets only .NET 10; the IdentityModel assembly, namespaces, and public APIs are preserved. See https://github.com/Luizinfo/IdentityModel/blob/main/CHANGELOG.md for migration notes.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Enable Trimming Warnings to allow consumers to publish as trimmed -->
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../icon.jpg" Pack="true" Visible="false" PackagePath="" />
    <None Include="../README.md" Pack="true" PackagePath=""/>
    <None Include="../LICENSE" Pack="true" PackagePath="" />
    <None Include="../NOTICE.md" Pack="true" PackagePath="" />
    <None Include="../CHANGELOG.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!--Strong Naming-->
  <PropertyGroup>
    <AssemblyOriginatorKeyFile>../key.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign Condition="'$(OS)' != 'Windows_NT'">true</PublicSign>
  </PropertyGroup>

  <!--SourceLink-->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="minver" Version="5.0.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <Target Name="SetAssemblyVersion" AfterTargets="MinVer">
    <PropertyGroup>
      <AssemblyVersion>$(MinVerMajor).$(MinVerMinor).$(MinVerPatch).0</AssemblyVersion>
    </PropertyGroup>
  </Target>
</Project>
